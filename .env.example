# ── Discord application (Developer Portal → your app) ──
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a Redirect URI registered under OAuth2 in the portal.
OAUTH_REDIRECT_URI=https://forge.example.com/callback

# ── LLM (any OpenAI-compatible endpoint) ──
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
# Groq alternative:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   Groq retires model IDs without warning — if generation suddenly 404s,
#   GET /models on their API and pick a live one.

# ── App ──
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///scaffold.db
BRAND_NAME=Scaffold
PORT=5000
